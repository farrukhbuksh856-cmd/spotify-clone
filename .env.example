# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spotify?retryWrites=true&w=majority

# Secret key for JWT signing
JWT_SECRET=your_jwt_secret_key_here

# ImageKit Private Key for audio file storage
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# (Optional) Client URL if testing cross-origin locally
CLIENT_URL=http://localhost:5173

# (Optional) Frontend custom API Base URL (defaults to /api)
# VITE_API_BASE_URL=/api
